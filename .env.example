# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password

# JWT Authentication
JWT_SECRET=supersecretjwtkey_luxuryhotel_change_this_in_production
